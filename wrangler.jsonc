{
  // Cloudflare Workers static site: publishes the site/ folder
  "name": "oceanicfunnels",
  "compatibility_date": "2026-10-01",
  // keep the *.workers.dev test link on; set false once www.oceanicfunnels.com is live
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
