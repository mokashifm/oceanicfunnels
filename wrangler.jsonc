{
  // Cloudflare Worker: serves the site/ folder and runs worker.js only for /api/* (Conversions API relay)
  "name": "oceanicfunnels",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
